# Copy this file to `.env` and fill in the values.
# Leave the Supabase values empty to run the app in local demo mode
# (data is saved on the device only, no sign-in).

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: free key from https://fdc.nal.usda.gov/api-key-signup
# Adds generic foods (rice, chicken, …) from USDA FoodData Central to search.
EXPO_PUBLIC_USDA_API_KEY=

# Sent to Open Food Facts with each request, as they ask apps to identify themselves.
EXPO_PUBLIC_OFF_USER_AGENT=MuscleX/1.0
